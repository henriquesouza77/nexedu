<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entrar · NexEdu</title>
  <link rel="icon" href="assets/img/favicon.png">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div class="login">
    <section class="login__brand">
      <div class="login__logo">
        <img src="assets/img/logo-256.png" alt="Logo NexEdu">
        <strong>NexEdu</strong>
      </div>
      <div>
        <h2>A rotina escolar, organizada em um só lugar.</h2>
        <p class="lead">Diário de classe, frequência, notas, atividades, ocorrências e comunicados — para diretores, coordenadores, professores, alunos e responsáveis.</p>
        <div class="login__features" id="features"></div>
      </div>
      <small>© 2026 NexEdu · Sistema Escolar e Acompanhamento Acadêmico</small>
    </section>

    <section class="login__form">
      <div class="login__box">
        <h1>Bem-vindo(a)!</h1>
        <p>Acesse com seu e-mail institucional e senha.</p>

        <form id="loginForm" novalidate>
          <div class="field">
            <label for="email">E-mail <span class="req">*</span></label>
            <input class="input" type="email" id="email" name="email" placeholder="voce@nexedu.com" autocomplete="username">
            <small class="hint"></small>
          </div>
          <div class="field">
            <label for="senha">Senha <span class="req">*</span></label>
            <div class="pw-wrap">
              <input class="input" type="password" id="senha" name="senha" placeholder="••••••" autocomplete="current-password">
              <button type="button" id="togglePw" aria-label="Mostrar senha"></button>
            </div>
            <small class="hint"></small>
          </div>
          <button class="btn btn-primary btn-block" type="submit">Entrar</button>
        </form>

        <div class="demo">
          <p>Acesso rápido (demonstração)</p>
          <div class="demo__grid" id="demoGrid"></div>
        </div>
      </div>
    </section>
  </div>

  <script src="js/data.js"></script>
  <script src="js/app.js"></script>
  <script src="js/pages/login.js"></script>
</body>
</html>
